# Copy this file to .env (same folder as manage.py) and fill in the values.
# These are the variables adeback/settings.py actually reads.

# Long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# True only on your computer. In production leave it False.
DEBUG_BOOL=True

# Comma-separated host names that may serve the site.
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL connection
DB_ENGINE=django.db.backends.postgresql
DB_NAME=ade
DB_USER=ade
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Frontend URLs allowed to call the API from the browser (comma-separated).
CORS_ALLOWED_ORIGINS=http://localhost:3030
CORS_ALLOWED_ORIGIN_REGEXES=http://localhost:3030
