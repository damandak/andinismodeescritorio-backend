# Copy this file to .env (same folder as manage.py) and fill in the values.
# These are the variables adeback/settings.py actually reads.

# Long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# True only on your computer. In production leave it False.
DEBUG_BOOL=True

# Comma-separated host names that may serve the site.
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL connection
DB_ENGINE=django.db.backends.postgresql
DB_NAME=ade
DB_USER=ade
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Frontend URLs allowed to call the API from the browser (comma-separated).
CORS_ALLOWED_ORIGINS=http://localhost:3030
CORS_ALLOWED_ORIGIN_REGEXES=http://localhost:3030

# --- Security (only used when DEBUG_BOOL=False). Defaults are fine. ---
# Browsers remember to use HTTPS for this long. Start with 3600 (1 hour); after
# a few days without problems, 31536000 (1 year).
#SECURE_HSTS_SECONDS=3600
# Only if nginx does NOT already redirect http:// to https://.
#SECURE_SSL_REDIRECT=False
# Emergency switch: False if the admin login stops working because it is being
# reached over plain http.
#SECURE_COOKIES=True
# Sites allowed to post the admin login form. By default https:// + each ALLOWED_HOSTS.
#CSRF_TRUSTED_ORIGINS=https://andinismodeescritorio.cl
